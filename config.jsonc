// QUOI afficher sur le deck. Même fichier pour Windows et macOS :
// une touche qui n'existe pas sur le système courant est simplement ignorée.
{
    // Port local (le serveur n'écoute que sur 127.0.0.1)
    "port": 7777,

    // Rubriques (dossiers) de la page d'accueil, dans l'ordre d'affichage.
    // Disponibles : vscode, git, k8s, docker, helm, terraform, ansible, brew, sec, vault, ssh, openssl, veille,
    //               favoris (tes sites, ajoutés depuis le deck : touche "Ajouter" ; enregistrés dans favoris.json, hors Git)
    // (brew = Homebrew sous macOS, Scoop sous Windows ; ansible masquée sous Windows)
    "sections": [
        "vscode",
        "git",
        "k8s",
        "docker",
        "helm",
        "terraform",
        "ansible",
        "brew",
        "ssh",
        "openssl",
        "veille",
        "favoris"
        // "sec",
        // "vault"
    ],

    // Raccourcis de la page d'accueil, placés après les dossiers (18 touches au total).
    // Disponibles : vscode, crc-start, crc-console, github, owasp, nvd, mitre, lock,
    //               kube-status, git-status, container-status (voyants)
    "shortcuts": [
        "kube-status",
        "git-status",
        "container-status",
        "lock"
    ],

    // Voyant kubectl : passe en rouge si le contexte ou le namespace
    // correspond à cette expression régulière (insensible à la casse)
    "prodPattern": "prod|prd",

    // Ajoute une touche "clear" (bas gauche) dans les rubriques qui tapent dans le terminal
    "clearKey": true,

    // Tes propres rubriques et touches, sans toucher au code. Une rubrique s'active en ajoutant son
    // identifiant dans "sections", un raccourci dans "shortcuts". Pour chaque touche :
    //   label   : texte affiché (obligatoire)
    //   command : commande tapée dans le terminal ; {} = emplacement du texte sélectionné.
    //             Variantes possibles : { "windows": "...", "mac": "..." } et/ou { "posix": "...", "powershell": "...", "cmd": "..." }
    //   enter   : true = exécutée tout de suite (pastille verte) ; absent = tapée, à compléter (orange)
    //   url     : à la place de command, ouvre un onglet (http:// ou https://)
    //   icon    : "lucide-<nom>" (https://lucide.dev/icons) ou un logo (https://simpleicons.org, ex. "github")
    //   color   : couleur "#rrggbb"
    "customSections": {
        // "perso": {
        //     "label": "Perso",
        //     "icon": "lucide-star",
        //     "color": "#607D8B",
        //     "keys": [
        //         { "label": "mes alias", "icon": "lucide-list", "command": "alias", "enter": true },
        //         { "label": "port-forward", "icon": "lucide-arrow-left-right", "command": "kubectl port-forward {} 8080:80" },
        //         { "label": "Grafana", "icon": "grafana", "url": "https://grafana.example.com" }
        //     ]
        // }
    },
    "customShortcuts": {
        // "backup": { "label": "backup", "icon": "lucide-save", "command": "./backup.sh", "enter": true }
    },

    // Outils à masquer partout (rubriques + raccourcis). Une touche est retirée si
    // sa commande commence par cet outil, ex. "crc" retire "crc status", "CRC start"...
    "excludeTools": [
        "crc"
    ]
}
